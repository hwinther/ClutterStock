{
  "name": "clutterstock-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --report-unused-disable-directives --format json",
    "openapi-typescript": "openapi-typescript ../backend/src/Api/openapi.json --enum -o ./app/api/types.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest --coverage",
    "coverage:ci": "vitest run --coverage",
    "stryker": "react-router typegen && stryker run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "load": "artillery run --output load-report.json load/clutterstock.yml",
    "load:report": "artillery report load-report.json"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/auto-instrumentations-web": "0.69.0",
    "@opentelemetry/context-zone": "3.0.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@react-router/node": "8.1.0",
    "@react-router/serve": "8.1.0",
    "isbot": "5.1.39",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.1.0",
    "redis": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "1.64.1",
    "artillery": "2.0.32",
    "@react-router/dev": "8.1.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.0",
    "allure": "3.21.0",
    "allure-playwright": "3.10.0",
    "dotenv": "18.0.8",
    "eslint": "^9.39.3",
    "eslint-formatter-compact": "^9.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "30.0.1",
    "lighthouse": "13.4.0",
    "monocart-reporter": "2.15.1",
    "msw": "2.15.0",
    "openapi-msw": "2.0.0",
    "openapi-typescript": "7.13.0",
    "otpauth": "9.5.1",
    "playwright-lighthouse": "4.0.0",
    "tailwindcss": "4.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.62.1",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "playwright-core": "1.64.1",
    "playwright": "1.64.1"
  }
}
