{
  "name": "clutterstock-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:ci": "eslint . --report-unused-disable-directives --format json",
    "openapi-typescript": "openapi-typescript ../backend/src/Api/openapi.json --enum -o ./app/api/types.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest --coverage",
    "coverage:ci": "vitest run --coverage",
    "stryker": "react-router typegen && stryker run"
  },
  "prettier": "@wshno/prettier-config",
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "@wshno/otel": "0.1.1",
    "isbot": "5.1.39",
    "oidc-client-ts": "3.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.5.1",
    "redis": "6.0.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.5.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@tailwindcss/vite": "4.3.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "@wshno/eslint-config": "0.2.0",
    "@wshno/prettier-config": "0.1.1",
    "@wshno/tsconfig": "0.1.1",
    "eslint": "10.13.0",
    "eslint-formatter-compact": "^9.0.1",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "openapi-msw": "2.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "typed-rest-client": {
      "qs": "6.17.1"
    }
  }
}
