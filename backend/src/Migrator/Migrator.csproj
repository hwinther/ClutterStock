<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ClutterStock.Migrator</RootNamespace>
    <!-- The plain runtime is enough: Infrastructure depends on Domain.Abstractions, not on Domain
         (which pulls in the ASP.NET Core shared framework). -->
    <ContainerBaseImage>mcr.microsoft.com/dotnet/runtime:11.0-resolute-chiseled</ContainerBaseImage>
    <ContainerRepository>clutterstock/migrator</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
  </ItemGroup>
</Project>
