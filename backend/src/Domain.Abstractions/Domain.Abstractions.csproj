<Project Sdk="Microsoft.NET.Sdk">
  <!-- The contracts Infrastructure implements (persistence, change notifications). Kept apart from
       Domain, which references the ASP.NET Core shared framework for its endpoints, so that
       Infrastructure and the Migrator run on the plain .NET runtime. The namespace stays
       ClutterStock.Domain.Abstractions, shared with Domain/Abstractions. -->
  <PropertyGroup>
    <RootNamespace>ClutterStock.Domain.Abstractions</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Entities\Entities.csproj" />
  </ItemGroup>
</Project>
